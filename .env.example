# ==========================================
# Scholaria Environment Variables
# Copy these into Railway's "Variables" tab
# ==========================================

# Port (Railway assigns PORT automatically, fallback to 3001 locally)
PORT=3001
NODE_ENV=production

# Whitelisted Origins (set to your Railway app domain, e.g. https://scholaria-xyz.up.railway.app)
ALLOWED_ORIGIN=

# Supabase Credentials (Required)
SUPABASE_URL=https://qxpsbewbgdwkermxeeso.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# AI Provider Keys
GEMINI_API_KEY=
OPENAI_API_KEY=

# Institutional Admin Code
ADMIN_REGISTRATION_KEY=HWA-ADMIN-2026

# Demo Accounts Mode (Set to true to allow demo accounts login)
DEMO_MODE=true
DEMO_STUDENT_EMAIL=
DEMO_STUDENT_PASSWORD=
DEMO_TEACHER_EMAIL=
DEMO_TEACHER_PASSWORD=
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=

# SMTP Email Configuration (Optional - for sending password reset emails)
SMTP_USER=
SMTP_PASS=
